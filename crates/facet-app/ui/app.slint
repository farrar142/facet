// facet 창: 코어의 「창 > 패널 > 탭」 상태를 그리는 자세히 보기.
// 판단은 하지 않는다. 그릴 값은 Rust(코어)가 넣고, 사용자 입력은 콜백으로 넘긴다.
// 사용자에게 보이는 글자는 모두 `@tr()`로 감싼다(ADR-0007).

import { ListView, Button, AboutSlint, Palette } from "std-widgets.slint";

// 자세히 보기의 한 행. 코어가 만든 값을 그대로 그린다.
export struct Row {
    name: string,
    folder: bool,
    modified: string,
    kind: string,
    size: string,
    // 선택한 항목인가.
    selected: bool,
    // 커서 항목인가(키보드가 가리키는 항목. 선택과 다르다).
    cursor: bool,
}

// 목록 읽기나 기본 프로그램으로 열기가 실패한 까닭. 문장은 화면이 `@tr()`로 만든다.
export enum Problem {
    none,
    // 목록 읽기
    not-found,
    permission-denied,
    not-a-folder,
    io,
    // 기본 프로그램으로 열기
    no-association,
    path-too-long,
    open-unsupported,
    open-failed,
    // 주소창 글자 해석
    address-empty,
    address-invalid-character,
    address-undefined-variable,
    address-not-absolute,
    address-not-found,
    address-permission-denied,
    address-io,
}

// 상태 줄의 이름 입력란 알림. 문장은 화면이 `@tr()`로 만든다(ADR-0007).
export enum Notice { none, entered, cancelled }

// 열 머리글 한 칸. 누르면 정렬하고, 오른쪽 경계를 끌어 너비를 바꾼다.
component Header inherits Rectangle {
    in property <string> text;
    in property <bool> sorted;
    in property <bool> descending;
    in property <bool> right-aligned;
    in-out property <length> column-width;
    callback sort();

    width: self.column-width;
    TouchArea {
        clicked => {
            root.sort();
        }
    }
    HorizontalLayout {
        padding-left: 6px;
        padding-right: 8px;
        spacing: 4px;
        alignment: root.right-aligned ? LayoutAlignment.end : LayoutAlignment.start;
        Text {
            text: root.text;
            vertical-alignment: center;
            overflow: elide;
            color: Palette.foreground.transparentize(30%);
        }
        if root.sorted: Text {
            text: root.descending ? "▼" : "▲";
            font-size: 9px;
            vertical-alignment: center;
            color: Palette.foreground.transparentize(30%);
        }
    }
    // 열 경계: 끌어서 너비를 바꾼다.
    Rectangle {
        x: parent.width - 4px;
        width: 8px;
        Rectangle {
            x: 3px;
            width: 1px;
            y: 4px;
            height: parent.height - 8px;
            background: Palette.border;
        }
        TouchArea {
            mouse-cursor: col-resize;
            moved => {
                if (self.pressed) {
                    root.column-width = max(40px, root.column-width + self.mouse-x - self.pressed-x);
                }
            }
        }
    }
}

// 내장 아이콘 두 가지: 폴더와 파일. 파일 종류별 아이콘은 S10이다.
component ItemIcon inherits Rectangle {
    in property <bool> folder;
    width: 16px;
    height: 16px;
    if root.folder: Rectangle {
        Rectangle {
            x: 1px;
            y: 2px;
            width: 6px;
            height: 3px;
            border-radius: 1px;
            background: #d9a521;
        }
        Rectangle {
            x: 1px;
            y: 4px;
            width: 14px;
            height: 10px;
            border-radius: 1px;
            background: #f2c94c;
        }
    }
    if !root.folder: Rectangle {
        x: 3px;
        y: 1px;
        width: 10px;
        height: 14px;
        background: #ffffff;
        border-width: 1px;
        border-color: #8a8a8a;
        Rectangle {
            x: parent.width - 4px;
            y: 0px;
            width: 4px;
            height: 4px;
            background: #c8c8c8;
        }
    }
}

// 주소창의 경로 조각 하나. 누르면 그 위치로 간다.
component Segment inherits Rectangle {
    in property <string> text;
    callback pressed();

    border-radius: 3px;
    background: touch.has-hover ? Palette.alternate-background : transparent;
    touch := TouchArea {
        clicked => {
            root.pressed();
        }
    }
    HorizontalLayout {
        padding-left: 5px;
        padding-right: 5px;
        Text {
            text: root.text;
            vertical-alignment: center;
            overflow: elide;
        }
    }
}

export component AppWindow inherits Window {
    title: "facet";
    preferred-width: 900px;
    preferred-height: 600px;
    default-font-size: 13px;

    // 주소창: 경로 조각(맨 위부터 지금 위치까지)의 이름.
    in property <[string]> segments;
    // 글자로 고쳐 쓰는 모드인가. 아니면 경로 조각 모드다.
    in property <bool> address-editing;
    // 고쳐 쓰는 글자. 모드를 열 때 Rust가 지금 위치를 채운다.
    in-out property <string> address-text;
    // 자동 완성 후보(하위 폴더 이름)와 Tab·화살표로 고른 후보의 번호(없으면 -1).
    in property <[string]> candidates;
    in property <int> candidate-highlight: -1;
    out property <length> candidate-row-height: 22px;
    in-out property <length> candidate-content-y <=> candidate-list.content-y;
    out property <length> candidate-view-height: candidate-list.visible-height;
    // 마지막 주소창 글자를 해석하지 못한 까닭과 값(글자·환경 변수 이름·경로)·자세한 내용. 탭은 원래 위치에 남는다.
    in property <Problem> address-problem: Problem.none;
    in property <string> address-problem-value;
    in property <string> address-problem-detail;
    // 「읽는 중」을 드러내는가. 코어가 읽기를 시작하고 100ms가 지나면 참이다.
    in property <bool> reading;
    // 마지막 이동(또는 새로 고침)이 실패한 까닭과 그 위치·자세한 내용. 탭은 원래 위치에 남는다.
    in property <Problem> list-problem: Problem.none;
    in property <string> list-problem-location;
    in property <string> list-problem-detail;
    // 마지막으로 파일을 기본 프로그램으로 열지 못한 까닭.
    in property <Problem> open-problem: Problem.none;
    in property <string> open-problem-detail;
    in property <[Row]> rows;
    // 정렬: 열(0 이름, 1 수정한 날짜, 2 유형, 3 크기)과 방향.
    in property <int> sort-column;
    in property <bool> sort-descending;
    // 상태 표시줄 수치.
    in property <int> item-count;
    in property <int> selected-count;
    // 선택한 파일 크기 합의 글자. 선택이 없으면 비어 있다.
    in property <string> selected-size;
    in-out property <bool> show-about;
    // 이름 입력란이 열린 행. 없으면 -1.
    in property <int> editing: -1;
    // 이름 입력란의 글자. 열 때 Rust가 현재 이름을 채운다.
    in-out property <string> edit-text;
    // 상태 줄에 보일 이름 입력란 알림의 종류.
    in property <Notice> notice: Notice.none;
    // 확정한 입력값과 입력란을 열 때의 이름. `notice`가 `entered`일 때만 쓴다.
    in property <string> notice-entered;
    in property <string> notice-original;
    out property <length> row-height: 24px;
    // 목록의 스크롤 위치. 0 이하이며, 목록 맨 위에서 화면 맨 위까지 내려간 거리의 음수다.
    in-out property <length> content-y <=> list.content-y;
    out property <length> view-height: list.visible-height;
    // 열 너비. 머리글 경계를 끌어 바꾼다.
    in-out property <length> name-width: 320px;
    in-out property <length> modified-width: 140px;
    in-out property <length> type-width: 120px;
    in-out property <length> size-width: 90px;

    // 키 입력 하나: 키의 글자와 수식 키. Rust가 명령이나 커서 이동으로 처리했으면 참을 돌려준다.
    // 거짓이면 글자 입력으로 보고 `typed`로 넘어온다(한글은 IME가 조합을 끝낸 뒤).
    callback key(string, bool, bool, bool) -> bool;
    // 글자로 이동: 조합이 끝난 글자.
    callback typed(string);
    // 행을 눌렀다: 행 번호, Ctrl, Shift.
    callback row-pressed(int, bool, bool);
    // 행을 두 번 눌렀다: 열기.
    callback row-opened(int);
    // 열 머리글을 눌렀다: 열 번호.
    callback sort-by(int);
    // 마우스 뒤로(거짓)·앞로(참) 버튼.
    callback mouse-history(bool);
    // F2: 커서 항목의 이름 입력란을 연다.
    callback begin-rename();
    // Enter: 입력을 확정한다. 파일 이름은 바꾸지 않는다.
    callback confirm-rename(string);
    // Esc: 입력을 취소한다.
    callback cancel-rename();
    // 경로 조각을 눌렀다: 조각 번호.
    callback segment-pressed(int);
    // 주소창의 빈 곳을 눌렀다: 고쳐 쓰는 모드로 바꾼다.
    callback begin-address-edit();
    // 고쳐 쓰는 글자가 바뀌었다: 자동 완성 후보를 새로 읽는다.
    callback address-edited(string);
    // Tab·↓(1)이나 Shift+Tab·↑(-1)로 후보를 골랐다. Rust가 `address-text`를 그 후보로 바꾸고, 입력 커서를 둘
    // 글자 끝의 바이트 위치를 돌려준다. 고를 후보가 없으면 -1이다.
    callback address-step(int) -> int;
    // Enter: 고쳐 쓴 글자로 간다. 해석해서 가기 시작했으면 참(고쳐 쓰는 모드를 닫았다), 해석하지 못했으면 거짓이다.
    callback address-go(string) -> bool;
    // 자동 완성 후보를 눌렀다: 그 폴더로 간다.
    callback candidate-pressed(int);
    // Esc 등: 고쳐 쓰는 모드를 닫고 경로 조각 모드로 돌아간다.
    callback cancel-address-edit();

    forward-focus: keys;

    // 목록으로 키보드를 돌린다. 주소창을 고쳐 쓰던 중이면 그만둔다.
    function focus-list() {
        if (root.address-editing) {
            root.cancel-address-edit();
        }
        keys.focus();
    }

    // 마우스 뒤로·앞으로 버튼은 어디를 눌러도 명령을 부른다.
    function history-button(event: PointerEvent) {
        if (event.kind == PointerEventKind.down) {
            if (event.button == PointerEventButton.back) {
                root.mouse-history(false);
            } else if (event.button == PointerEventButton.forward) {
                root.mouse-history(true);
            }
        }
    }

    MenuBar {
        Menu {
            title: @tr("도움말");
            MenuItem {
                title: @tr("facet 정보");
                activated => {
                    root.show-about = true;
                }
            }
        }
    }

    TouchArea {
        pointer-event(event) => {
            root.history-button(event);
        }
    }

    // 키 입력을 받는 곳. 보이지 않는 입력란이다: 한글 IME가 조합을 끝낸 글자를 받으려면 입력란이어야 한다.
    // 명령·커서 키는 `key`가 먼저 가져가고, 나머지 글자만 입력란에 들어갔다가 곧바로 `typed`로 넘어간다.
    keys := TextInput {
        x: 0px;
        y: 0px;
        width: 1px;
        height: 1px;
        single-line: true;
        color: transparent;
        selection-background-color: transparent;
        key-pressed(event) => {
            if (root.show-about) {
                if (event.text == Key.Escape) {
                    root.show-about = false;
                }
                return accept;
            }
            if (event.text == Key.F2) {
                root.begin-rename();
                return accept;
            }
            if (root.key(event.text, event.modifiers.control, event.modifiers.alt, event.modifiers.shift)) {
                return accept;
            }
            // Ctrl·Alt 조합(붙여넣기 등)은 글자 입력이 아니다.
            if (event.modifiers.control || event.modifiers.alt) {
                return accept;
            }
            reject
        }
        edited => {
            if (self.text != "") {
                root.typed(self.text);
                self.text = "";
            }
        }
    }

    VerticalLayout {
        padding: 8px;
        spacing: 4px;

        // 주소창. 평소에는 경로 조각을 누르는 모드이고, 빈 곳을 누르거나 주소창 고쳐 쓰기 명령(Alt+D·Ctrl+L·F4)이면
        // 글자로 고쳐 쓰는 모드가 된다.
        address-bar := Rectangle {
            height: 28px;
            background: Palette.background;
            border-width: 1px;
            border-radius: 3px;
            border-color: root.address-editing ? Palette.accent-background : Palette.border;
            clip: true;

            if !root.address-editing: Rectangle {
                // 조각 사이나 조각 뒤의 빈 곳을 누르면 고쳐 쓴다.
                TouchArea {
                    mouse-cursor: text;
                    clicked => {
                        root.begin-address-edit();
                    }
                }
                HorizontalLayout {
                    padding: 2px;
                    alignment: start;
                    for segment[i] in root.segments: HorizontalLayout {
                        Segment {
                            text: segment;
                            pressed => {
                                root.segment-pressed(i);
                                root.focus-list();
                            }
                        }
                        if i < root.segments.length - 1: Text {
                            text: "›";
                            vertical-alignment: center;
                            color: Palette.foreground.transparentize(40%);
                        }
                    }
                }
            }

            // 고쳐 쓰는 입력란. 한글 IME의 조합 글자와 후보 창은 TextInput이 처리한다.
            if root.address-editing: TextInput {
                x: 6px;
                width: parent.width - 12px;
                single-line: true;
                vertical-alignment: center;
                color: Palette.foreground;
                text <=> root.address-text;
                init => {
                    self.focus();
                    self.select-all();
                }
                edited => {
                    root.address-edited(self.text);
                }
                accepted => {
                    if (root.address-go(self.text)) {
                        keys.focus();
                    }
                }
                key-pressed(event) => {
                    if (event.text == Key.Escape) {
                        root.cancel-address-edit();
                        keys.focus();
                        return accept;
                    }
                    if (event.text == Key.Tab || event.text == Key.Backtab || event.text == Key.DownArrow
                        || event.text == Key.UpArrow) {
                        let backward = event.text == Key.Backtab || event.text == Key.UpArrow
                            || (event.text == Key.Tab && event.modifiers.shift);
                        let end = root.address-step(backward ? -1 : 1);
                        if (end >= 0) {
                            self.set-selection-offsets(end, end);
                        }
                        return accept;
                    }
                    reject
                }
            }
        }

        if root.address-problem != Problem.none: Text {
            text: root.address-problem == Problem.address-empty ? @tr("주소를 입력하세요")
                : root.address-problem == Problem.address-invalid-character ? @tr("주소에 쓸 수 없는 글자가 있습니다: {}", root.address-problem-value)
                : root.address-problem == Problem.address-undefined-variable ? @tr("환경 변수가 없습니다: {}", root.address-problem-value)
                : root.address-problem == Problem.address-not-absolute ? @tr("전체 경로가 아닙니다: {}", root.address-problem-value)
                : root.address-problem == Problem.address-not-found ? @tr("위치가 없습니다: {}", root.address-problem-value)
                : root.address-problem == Problem.address-permission-denied ? @tr("위치를 확인할 권한이 없습니다: {}", root.address-problem-value)
                : @tr("위치를 확인하지 못했습니다: {}: {}", root.address-problem-value, root.address-problem-detail);
            wrap: word-wrap;
            color: #c42b1c;
        }

        if root.list-problem != Problem.none: Text {
            text: root.list-problem == Problem.not-found ? @tr("위치가 없습니다: {}", root.list-problem-location)
                : root.list-problem == Problem.permission-denied ? @tr("위치를 읽을 권한이 없습니다: {}", root.list-problem-location)
                : root.list-problem == Problem.not-a-folder ? @tr("폴더가 아닙니다: {}", root.list-problem-location)
                : @tr("위치를 읽지 못했습니다: {}: {}", root.list-problem-location, root.list-problem-detail);
            wrap: word-wrap;
            color: #c42b1c;
        }

        if root.open-problem != Problem.none: Text {
            text: root.open-problem == Problem.no-association ? @tr("이 형식의 파일에 연결된 프로그램이 없습니다")
                : root.open-problem == Problem.path-too-long ? @tr("경로가 너무 길어 셸이 열 수 없습니다")
                : root.open-problem == Problem.open-unsupported ? @tr("이 환경에서는 기본 프로그램으로 열 수 없습니다")
                : @tr("파일을 열지 못했습니다: {}", root.open-problem-detail);
            wrap: word-wrap;
            color: #c42b1c;
        }

        // 열 머리글
        HorizontalLayout {
            height: root.row-height;
            Header {
                text: @tr("이름");
                column-width <=> root.name-width;
                sorted: root.sort-column == 0;
                descending: root.sort-descending;
                sort => {
                    root.sort-by(0);
                    root.focus-list();
                }
            }
            Header {
                text: @tr("수정한 날짜");
                column-width <=> root.modified-width;
                sorted: root.sort-column == 1;
                descending: root.sort-descending;
                sort => {
                    root.sort-by(1);
                    root.focus-list();
                }
            }
            Header {
                text: @tr("유형");
                column-width <=> root.type-width;
                sorted: root.sort-column == 2;
                descending: root.sort-descending;
                sort => {
                    root.sort-by(2);
                    root.focus-list();
                }
            }
            Header {
                text: @tr("크기");
                right-aligned: true;
                column-width <=> root.size-width;
                sorted: root.sort-column == 3;
                descending: root.sort-descending;
                sort => {
                    root.sort-by(3);
                    root.focus-list();
                }
            }
            Rectangle { }
        }

        Rectangle {
            vertical-stretch: 1;

            // ListView는 보이는 행만 화면 요소로 만든다.
            // 높이를 행 높이의 정수배로 맞춘다. ListView는 먼 곳으로 뛸 때 스크롤 위치를 행 경계로
            // 내림하므로, 그렇지 않으면 End 뒤 마지막 행이 조금 가려진다.
            list := ListView {
                y: 0;
                height: floor(parent.height / root.row-height) * root.row-height;
                for row[i] in root.rows: Rectangle {
                    height: root.row-height;
                    background: row.selected ? Palette.selection-background : transparent;
                    // 커서: 선택과 구분되게 테두리로 보인다.
                    Rectangle {
                        border-width: row.cursor ? 1px : 0px;
                        border-color: Palette.accent-background;
                    }
                    // 입력란보다 아래에 둔다. 그래야 입력란 안을 누르면 입력란이 받는다.
                    TouchArea {
                        pointer-event(event) => {
                            root.history-button(event);
                            if (event.kind == PointerEventKind.down && event.button == PointerEventButton.left) {
                                if (i == root.editing) {
                                    return;
                                }
                                // 다른 행을 누르면 탐색기처럼 입력을 확정하고 그 행을 고른다.
                                if (root.editing >= 0) {
                                    root.confirm-rename(root.edit-text);
                                }
                                root.row-pressed(i, event.modifiers.control, event.modifiers.shift);
                                root.focus-list();
                            }
                        }
                        double-clicked => {
                            if (i != root.editing) {
                                root.row-opened(i);
                                root.focus-list();
                            }
                        }
                    }
                    HorizontalLayout {
                        HorizontalLayout {
                            width: root.name-width;
                            padding-left: 6px;
                            padding-right: 8px;
                            spacing: 6px;
                            VerticalLayout {
                                alignment: center;
                                ItemIcon {
                                    folder: row.folder;
                                }
                            }
                            if i != root.editing: Text {
                                text: row.name;
                                overflow: elide;
                                vertical-alignment: center;
                                color: row.selected ? Palette.selection-foreground : Palette.foreground;
                            }
                            // 이름 입력란. 한글 IME의 조합 글자와 후보 창은 TextInput이 처리한다.
                            if i == root.editing: Rectangle {
                                horizontal-stretch: 1;
                                background: Palette.background;
                                border-width: 1px;
                                border-color: Palette.accent-background;
                                clip: true;
                                name-input := TextInput {
                                    x: 3px;
                                    width: parent.width - 6px;
                                    single-line: true;
                                    vertical-alignment: center;
                                    color: Palette.foreground;
                                    text <=> root.edit-text;
                                    init => {
                                        self.focus();
                                        self.select-all();
                                    }
                                    accepted => {
                                        root.confirm-rename(self.text);
                                        keys.focus();
                                    }
                                    key-pressed(event) => {
                                        if (event.text == Key.Escape) {
                                            root.cancel-rename();
                                            keys.focus();
                                            return accept;
                                        }
                                        // 입력란이 열린 동안에는 목록을 움직이지 않는다.
                                        if (event.text == Key.UpArrow || event.text == Key.DownArrow || event.text == Key.PageUp
                                            || event.text == Key.PageDown || event.text == Key.F2) {
                                            return accept;
                                        }
                                        reject
                                    }
                                }
                            }
                        }
                        Text {
                            width: root.modified-width;
                            text: row.modified;
                            overflow: elide;
                            vertical-alignment: center;
                            color: row.selected ? Palette.selection-foreground : Palette.foreground;
                        }
                        Text {
                            width: root.type-width;
                            text: row.kind;
                            overflow: elide;
                            vertical-alignment: center;
                            color: row.selected ? Palette.selection-foreground : Palette.foreground;
                        }
                        HorizontalLayout {
                            width: root.size-width;
                            padding-right: 8px;
                            Text {
                                text: row.size;
                                overflow: elide;
                                horizontal-alignment: right;
                                vertical-alignment: center;
                                color: row.selected ? Palette.selection-foreground : Palette.foreground;
                            }
                        }
                        Rectangle { }
                    }
                }
            }

            if root.reading: Rectangle {
                background: Palette.background.transparentize(30%);
                Text {
                    text: @tr("읽는 중…");
                    horizontal-alignment: center;
                    vertical-alignment: center;
                }
            }
        }

        HorizontalLayout {
            spacing: 16px;
            Text {
                text: @tr("{n}개 항목" | "{n}개 항목" % root.item-count);
                color: Palette.foreground.transparentize(40%);
            }
            if root.selected-count > 0: Text {
                text: @tr("{n}개 선택함" | "{n}개 선택함" % root.selected-count);
                color: Palette.foreground.transparentize(40%);
            }
            if root.selected-size != "": Text {
                text: root.selected-size;
                color: Palette.foreground.transparentize(40%);
            }
            Text {
                text: root.notice == Notice.entered
                    ? @tr("입력한 이름: 「{}」 (원래 이름 「{}」, 실제 파일 이름은 바꾸지 않았습니다)", root.notice-entered, root.notice-original)
                    : root.notice == Notice.cancelled ? @tr("이름 입력을 취소했습니다") : "";
                horizontal-stretch: 1;
                overflow: elide;
                color: Palette.foreground.transparentize(40%);
            }
        }
    }

    // 주소창 자동 완성 후보. 목록 위에 겹쳐 그리도록 창 전체를 덮는 층에 두고 주소창 바로 아래에 놓는다.
    Rectangle {
        Rectangle {
            visible: root.address-editing && root.candidates.length > 0;
            x: address-bar.absolute-position.x - parent.absolute-position.x;
            y: address-bar.absolute-position.y - parent.absolute-position.y + address-bar.height;
            width: address-bar.width;
            height: min(root.candidates.length, 10) * root.candidate-row-height + 2px;
            background: Palette.background;
            border-width: 1px;
            border-color: Palette.border;
            drop-shadow-blur: 6px;
            drop-shadow-color: #00000040;
            candidate-list := ListView {
                x: 1px;
                y: 1px;
                width: parent.width - 2px;
                height: parent.height - 2px;
                for candidate[i] in root.candidates: Rectangle {
                    height: root.candidate-row-height;
                    background: i == root.candidate-highlight ? Palette.selection-background
                        : candidate-touch.has-hover ? Palette.alternate-background : transparent;
                    candidate-touch := TouchArea {
                        clicked => {
                            root.candidate-pressed(i);
                            keys.focus();
                        }
                    }
                    HorizontalLayout {
                        padding-left: 6px;
                        padding-right: 6px;
                        spacing: 6px;
                        VerticalLayout {
                            alignment: center;
                            ItemIcon {
                                folder: true;
                            }
                        }
                        Text {
                            text: candidate;
                            overflow: elide;
                            vertical-alignment: center;
                            color: i == root.candidate-highlight ? Palette.selection-foreground : Palette.foreground;
                        }
                    }
                }
            }
        }
    }

    // 정보 화면: Slint 로열티 프리 라이선스의 표시 의무(ADR-0002)로 AboutSlint를 보인다.
    if root.show-about: Rectangle {
        background: #00000080;
        TouchArea { }
        Rectangle {
            width: 360px;
            height: 320px;
            background: Palette.background;
            border-radius: 8px;
            VerticalLayout {
                padding: 16px;
                spacing: 12px;
                Text {
                    text: "facet";
                    font-size: 18px;
                    font-weight: 700;
                    horizontal-alignment: center;
                }
                Text {
                    text: @tr("Windows 파일 탐색기를 대체하는 앱");
                    horizontal-alignment: center;
                }
                AboutSlint { }
                HorizontalLayout {
                    alignment: center;
                    Button {
                        text: @tr("닫기");
                        clicked => {
                            root.show-about = false;
                            keys.focus();
                        }
                    }
                }
            }
        }
    }
}
